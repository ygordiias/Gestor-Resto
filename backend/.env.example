# Exemplo de variáveis de ambiente do backend. Copie para .env e preencha.
# NUNCA coloque valores reais neste arquivo: ele vai para o repositório.

# --- Banco e autenticação (já existentes) ---
MONGO_URL=
DB_NAME=
# mínimo de 32 caracteres
SECRET_KEY=

# --- Integração NostFood (iFood / 99) ---
# "true" liga webhook, polling e envio de status. Desligada por padrão.
NOSTFOOD_ENABLED=false
# Chave da API (painel NostFood: API Externa > Permitir Consultas > Nova Chave).
# Enviada no header X-API-Key. Precisa da permissão "Pedidos".
NOSTFOOD_API_KEY=
# Segredo do webhook usado no HMAC-SHA256 do header X-NostFood-Signature.
NOSTFOOD_WEBHOOK_SECRET=
# Endereço base da API pública.
NOSTFOOD_BASE_URL=https://nostfood.com/api/public
# Intervalo do polling de segurança, em segundos (mínimo 30).
NOSTFOOD_POLL_SECONDS=90
# "true" envia em_preparo/pronto para a NostFood (atualizar-pedido.php).
# Com "false" (padrão) o Gestor NÃO altera pedidos na NostFood: só registra no
# log o que teria enviado. Deixe false em teste/homologação.
NOSTFOOD_SEND_STATUS=false
